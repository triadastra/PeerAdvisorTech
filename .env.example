# ── Workspace backend (server/) — all optional ────────────────────────────
# The app runs with no .env at all: a signing secret is generated once to
# server/.data/secret on first start. Set AUTH_SECRET to pin it (recommended
# in production and when sharing across machines). PORT defaults to 3001.

AUTH_SECRET=
PORT=3001

# ── Resend application delivery ──────────────────────────────────────────
# Keep the API key server-side. Never prefix it with VITE_.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=PA Tech Website <website@standardcas.org>
RESEND_TO_EMAIL=patech@standardcas.org
