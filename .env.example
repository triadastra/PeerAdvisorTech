# ── Workspace backend (server/) — all optional ────────────────────────────
# The app runs with no .env at all: a signing secret is generated once to
# server/.data/secret on first start. Set AUTH_SECRET to pin it (recommended
# in production and when sharing across machines). PORT defaults to 3001.

AUTH_SECRET=
PORT=3001

# ── Resend application delivery ──────────────────────────────────────────
# Keep the API key server-side. Never prefix it with VITE_.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=PA Tech Website <website@standardcas.org>
RESEND_TO_EMAIL=patech.shsid@outlook.com

# Deterministic contribution scoring (no AI service)
# Default: .venv/bin/python under the project directory
# SCORING_PYTHON=/absolute/path/to/python
# Optional: random secret used ONLY by a trusted CI runner to attest exact SHAs.
# Leave unset to keep the test bonus at zero.
CI_REPORT_TOKEN=
# Optional: comma-separated workspace user UUIDs authorized to rate a commit.
# Reviewers cannot rate tasks they have pushed to. Default R is zero.
REVIEWER_IDS=
